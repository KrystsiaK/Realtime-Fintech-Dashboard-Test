{
  "name": "fintech-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:wasm": "cargo build --manifest-path wasm/producer/Cargo.toml --release --target wasm32-unknown-unknown && node -e \"require('fs').copyFileSync('wasm/producer/target/wasm32-unknown-unknown/release/producer.wasm','public/producer.wasm')\"",
    "prestart": "npm run build:wasm",
    "start": "ng serve",
    "prebuild": "npm run build:wasm",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:wasm": "cargo test --manifest-path wasm/producer/Cargo.toml",
    "test:all": "npm run test:wasm && npm test"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.29",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.15"
  }
}
